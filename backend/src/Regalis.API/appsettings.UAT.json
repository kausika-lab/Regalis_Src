{
  // UAT template (Release 3). Placeholders only — real values arrive via
  // environment variables or the host's secret store, never in git:
  //   ConnectionStrings__Default, Jwt__SigningKey, Seed__AdminPassword,
  //   Cors__AllowedOrigins__0, Payments__Razorpay__KeyId / KeySecret (if used).
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    // UAT applies deploy/sql/release-3-idempotent.sql (or a controlled
    // `dotnet ef database update`) — the app never migrates on startup here.
    "MigrateOnStartup": false,
    // Seeding is idempotent (keyed by code); safe to leave on. The admin user
    // is only created when Seed:AdminPassword is provided.
    "SeedOnStartup": true
  },
  "Payments": {
    "Provider": "Sandbox"
  },
  "Storage": {
    "UploadRoot": "App_Data/uploads"
  }
}
