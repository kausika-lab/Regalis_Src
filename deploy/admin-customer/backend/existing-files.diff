+	/// <summary>
+	/// Today's occupancy: booked workspace-hours / open workspace-hours, per location.
+	/// For each active location: open hours = today's WorkingHoursStart..End (IST) x its active
+	/// bookable workspaces. Booked hours = every occupying booking (Booking.OccupancyStatuses)
+	/// on an active bookable workspace there, CLIPPED to that open window -- so a monthly or
+	/// multi-day booking counts only today's open hours, and a booking running past closing
+	/// counts only up to closing. (Before 13 Nov 2026 the whole DurationMinutes of any booking
+	/// touching today was added, and every location's workspaces were divided by the default
+	/// location's hours; one confirmed monthly booking alone showed ~400%.)
+	/// </summary>
+	internal async Task<(decimal Percent, int Workspaces, decimal BookedHours, decimal OpenHours)> OccupancyTodayAsync(DateOnly todayIst, int? locationId, CancellationToken ct)
+	{
+		DateTime dayStartUtc = IstClock.ToUtc(todayIst.ToDateTime(TimeOnly.MinValue));
+		DateTime dayEndUtc = IstClock.ToUtc(todayIst.AddDays(1).ToDateTime(TimeOnly.MinValue));
+		var locations = await db.Locations.AsNoTracking().Where((Location l) => l.IsActive && (locationId == null || l.LocationId == locationId)).Select((Location l) => new { l.LocationId, l.WorkingHoursStart, l.WorkingHoursEnd }).ToListAsync(ct);
+		var workspaceCounts = await (from w in db.Workspaces.AsNoTracking()
+			where w.IsBookable && w.IsActive && (locationId == null || w.LocationId == locationId)
+			group w by w.LocationId into g
+			select new { LocationId = g.Key, Count = g.Count() }).ToListAsync(ct);
+		var bookings = await db.Bookings.AsNoTracking().Where((Booking b) => Booking.OccupancyStatuses.Contains(b.Status) && b.StartUtc < dayEndUtc && dayStartUtc < b.EndUtc && b.Workspace.IsBookable && b.Workspace.IsActive && (locationId == null || b.LocationId == locationId)).Select((Booking b) => new { b.LocationId, b.StartUtc, b.EndUtc }).ToListAsync(ct);
+		decimal bookedMinutes = 0m;
+		decimal openMinutes = 0m;
+		int workspaces = 0;
+		foreach (var location in locations)
+		{
+			int count = workspaceCounts.FirstOrDefault(x => x.LocationId == location.LocationId)?.Count ?? 0;
+			if (count == 0 || location.WorkingHoursEnd <= location.WorkingHoursStart)
+			{
+				continue;
+			}
+			DateTime openUtc = IstClock.ToUtc(todayIst.ToDateTime(location.WorkingHoursStart));
+			DateTime closeUtc = IstClock.ToUtc(todayIst.ToDateTime(location.WorkingHoursEnd));
+			workspaces += count;
+			openMinutes += (decimal)count * (decimal)(closeUtc - openUtc).TotalMinutes;
+			foreach (var booking in bookings.Where(b => b.LocationId == location.LocationId))
+			{
+				DateTime from = (booking.StartUtc > openUtc) ? booking.StartUtc : openUtc;
+				DateTime to = (booking.EndUtc < closeUtc) ? booking.EndUtc : closeUtc;
+				if (to > from)
+				{
+					bookedMinutes += (decimal)(to - from).TotalMinutes;
+				}
+			}
+		}
+		decimal percent = (openMinutes == 0m) ? 0m : Math.Round(bookedMinutes / openMinutes * 100m, 1);
+		return (Percent: percent, Workspaces: workspaces, BookedHours: Math.Round(bookedMinutes / 60m, 1), OpenHours: Math.Round(openMinutes / 60m, 1));
+	}
