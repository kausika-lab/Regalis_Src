@echo off
rem Copy this file to local-dev\local.env.cmd and edit it. Git ignores that copy.
rem start-local.cmd calls it after its own defaults, so anything set here wins.

rem ---- SQL Server ----------------------------------------------------------
rem The instance that holds the Regalis databases on THIS machine. Find it with:
rem   powershell -Command "Get-Service 'MSSQL*' | Format-Table Name, Status"
rem A default instance is just the host name, e.g. "localhost".
rem set "REGALIS_SQL_INSTANCE=localhost\SQLEXPRESS"
rem set "REGALIS_DB=RegalisWorkSpace_Dev"

rem Replaces the whole connection string, for SQL logins or a remote server.
rem set "ConnectionStrings__Default=Server=localhost\SQLEXPRESS;Database=RegalisWorkSpace_Dev;User Id=sa;Password=...;TrustServerCertificate=True;MultipleActiveResultSets=True"

rem ---- ports ---------------------------------------------------------------
rem Change these only together with the launch URLs in .vscode/launch.json.
rem set "REGALIS_API_PORT=81"
rem set "REGALIS_WEB_PORT=8080"

rem ---- the service worker --------------------------------------------------
rem The dev website disables the app's Workbox service worker, so edited bundles
rem show up on reload instead of coming from its cache. Set this to serve the
rem real one from frontend\sw.js (offline behaviour, install prompt).
rem set "REGALIS_SERVE_SW=1"

rem ---- optional extras -----------------------------------------------------
rem Seeds an admin account when the database has none (idempotent).
rem set "Seed__AdminPassword=..."
rem Real OTP e-mail instead of the console channel.
rem set "Otp__Channel=Email"
rem set "Smtp__Host=smtp.example.com"
rem set "Smtp__Username=..."
rem set "Smtp__Password=..."
rem set "Smtp__FromAddress=no-reply@example.com"
rem Sandbox online payments.
rem set "Payments__Razorpay__KeyId=..."
rem set "Payments__Razorpay__KeySecret=..."

rem The API build to run (default: the repo's api\). Point it at the build with the installed kits:
rem set "REGALIS_API_DIR=D:\Regalis\local-dev\api"
